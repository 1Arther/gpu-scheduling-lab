+      == 1) && (!has(object.spec.hostPID) || !object.spec.hostPID) && (!has(object.spec.hostNetwork)
+      || !object.spec.hostNetwork) && (!has(object.spec.volumes) || object.spec.volumes.size()
+      == 0) && (has(object.spec.automountServiceAccountToken) && !object.spec.automountServiceAccountToken)
