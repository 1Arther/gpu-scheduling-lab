+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: rf-v7-canary-config
+  namespace: volcano-system
+  labels:
+    gpu-lab/experiment: round7-rf
+data:
+  volcano-scheduler.conf: "actions: enqueue, allocate, backfill\ntiers:\n- plugins:\n\
+    \  - name: priority\n  - name: gang\n    enablePreemptable: false\n  - name: conformance\n\
+    - plugins:\n  - name: overcommit\n  - name: drf\n    enablePreemptable: false\n\
+    \  - name: deviceshare\n    arguments:\n      deviceshare.VGPUEnable: true\n \
+    \     deviceshare.GPUSelectPolicy: dqn-job\n      deviceshare.DQNGRPCEndpoint:\
+    \ dqn-scheduler-grpc.volcano-system.svc.cluster.local:50051\n      deviceshare.RFEnable:\
+    \ true\n      deviceshare.RFCanaryEnable: true\n      deviceshare.RFCanaryNamespace:\
+    \ gpu-rf-tests\n      deviceshare.RFCanaryScheduleWeight: 1\n      deviceshare.RFEndpoint:\
+    \ http://127.0.0.1:18081/v1/rank\n      deviceshare.RFTimeoutMS: 500\n      deviceshare.RFModelVersion:\
+    \ rf-v4-known-states-ee35cfabe30f\n      deviceshare.RFPredictionEnabled: true\n\
+    \  - name: predicates\n  - name: proportion\n  - name: nodeorder\n  - name: binpack\n"
--- historical-round7/A-scheduler-patch-DRAFT.yaml
+++ logical-window/A-scheduler-patch-DRAFT.yaml
@@ -0,0 +1,87 @@
+spec:
+  strategy:
+    type: Recreate
+    rollingUpdate: null
+  template:
+    spec:
+      automountServiceAccountToken: false
+      containers:
+      - name: volcano-scheduler
+        image: gpu-lab/volcano-rf:canary-build-required
+        command:
+        - /vc-scheduler-rf
+        volumeMounts:
+        - mountPath: /vc-scheduler
+          $patch: delete
+        - name: rf-api-token
+          mountPath: /var/run/secrets/kubernetes.io/serviceaccount
+          readOnly: true
+      - name: rf-model
+        image: gpu-lab/rf-model:round7-build-required
+        imagePullPolicy: IfNotPresent
+        command:
+        - python
+        - -m
+        - gpu_lab.runtime.audit_server
+        - --port
+        - '18081'
+        env:
+        - name: OMP_NUM_THREADS
+          value: '1'
+        - name: OPENBLAS_NUM_THREADS
+          value: '1'
+        - name: MKL_NUM_THREADS
+          value: '1'
+        securityContext:
+          allowPrivilegeEscalation: false
+          readOnlyRootFilesystem: true
+          capabilities:
+            drop:
+            - ALL
+        resources:
+          requests:
+            cpu: 100m
+            memory: 256Mi
+          limits:
+            cpu: '1'
+            memory: 1Gi
+        readinessProbe:
+          exec:
+            command: &id001
+            - python
+            - -c
+            - import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:18081/health',timeout=1));
+              assert r['model_ready'] and r['model_version']=='rf-v4-known-states-ee35cfabe30f'
+          periodSeconds: 3
+        startupProbe:
+          exec:
+            command: *id001
+          periodSeconds: 2
+          failureThreshold: 30
+        volumeMounts:
+        - name: rf-tmp
+          mountPath: /tmp
+      volumes:
+      - name: local-vc-scheduler
+        $patch: delete
+      - name: volcano-scheduler-config
+        configMap:
+          name: rf-v7-canary-config
+      - name: rf-tmp
+        emptyDir: {}
+      - name: rf-api-token
+        projected:
+          sources:
+          - serviceAccountToken:
+              path: token
+              expirationSeconds: 3600
+          - configMap:
+              name: kube-root-ca.crt
+              items:
+              - key: ca.crt
+                path: ca.crt
+          - downwardAPI:
+              items:
+              - path: namespace
+                fieldRef:
+                  fieldPath: metadata.namespace
